# GEMINI_API_KEY: Clave de API de Google Gemini usada exclusivamente en el servidor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Modelo Flash vigente de baja latencia con visión (por defecto gemini-3.1-flash-lite).
GEMINI_MODEL="gemini-3.1-flash-lite"

# VITE_FIREBASE_VAPID_KEY: Llave pública Web Push (VAPID) obtenida en Firebase Console > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=""

# APP_URL: URL pública donde corre la aplicación.
APP_URL="MY_APP_URL"
