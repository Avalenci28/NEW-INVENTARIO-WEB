# GEMINI_API_KEY: Clave de API de Google Gemini usada exclusivamente en el servidor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Modelo Flash vigente con visión (por defecto gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: URL pública donde corre la aplicación.
APP_URL="MY_APP_URL"
